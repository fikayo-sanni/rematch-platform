# Server Configuration
PORT=3000

# Ductape SDK Configuration
# Get these credentials from your Ductape Workbench at https://workbench.ductape.app
DUCTAPE_ACCESS_KEY=your_access_key
DUCTAPE_PRODUCT_TAG=your_product_tag
DUCTAPE_ENV=development

# Ductape Services Configuration
DUCTAPE_DATABASE=true
DUCTAPE_GRAPH=true
DUCTAPE_STORAGE=true
DUCTAPE_CACHE=true
DUCTAPE_MESSAGING=true

# LiveKit Configuration (Optional - for Match Voice Chat)
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret
LIVEKIT_URL=wss://your-project.livekit.cloud
